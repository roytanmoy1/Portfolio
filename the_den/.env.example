# Set this to your deployed portfolio URL before production builds.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Neon pooled connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional: create and verify a Formspree form, then set its endpoint here.
# Keep this server-only; if omitted, the contact form opens the visitor's email client instead.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-verified-form-id
