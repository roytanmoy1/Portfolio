# Set this to your deployed portfolio URL before production builds.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Neon pooled connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Authenticated SMTP delivery. Keep every value server-only.
# For Gmail, enable 2-Step Verification and use a 16-character app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=you@gmail.com
CONTACT_TO_EMAIL=you@gmail.com

# Portfolio AI assistant. Never prefix these with NEXT_PUBLIC_.
# Generate CHAT_TOKEN_SECRET with a cryptographically secure password generator (32+ characters).
CHAT_TOKEN_SECRET=replace-with-a-long-random-secret
CHAT_WEBSOCKET_URL=https://your-neon-function-origin/

# Neon Function-only variables. GEMINI_API_KEY belongs in Neon, not in browser code.
CHAT_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example
GEMINI_API_KEY=replace-with-a-rotated-gemini-key
GEMINI_MODEL=gemini-2.5-flash
